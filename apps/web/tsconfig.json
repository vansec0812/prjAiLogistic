{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@plantcare/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@plantcare/rule-engine": [
        "../../packages/rule-engine/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-live-e2e/types/**/*.ts",
    ".next-live-e2e/dev/types/**/*.ts",
    ".next-gemini-test/types/**/*.ts",
    ".next-gemini-test/dev/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts",
    ".next-proxy-check/types/**/*.ts",
    ".next-proxy-check/dev/types/**/*.ts",
    ".next-vercel-check/types/**/*.ts",
    ".next-vercel-check/dev/types/**/*.ts",
    ".next-mvp-e2e/types/**/*.ts",
    ".next-mvp-e2e/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
