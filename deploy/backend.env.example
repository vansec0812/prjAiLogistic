# Copy to .env.backend.local; never commit the populated file.
APP_ORIGIN=https://your-frontend.vercel.app
PLANTCARE_OTP_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=replace-with-server-key
GEMINI_VISION_MODEL=replace-with-enabled-vision-model
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
AI_DAILY_CALL_LIMIT=200
GEMINI_TIMEOUT_MS=30000
SMS_ADAPTER_URL=https://your-sms-adapter.example/send
SMS_ADAPTER_TOKEN=replace-with-sms-token
