# Production only. Neon integration injects DATABASE_URL automatically.
PLANTCARE_STORAGE=postgres
APP_ORIGIN=https://prj-ai-logistic.vercel.app
PLANTCARE_OTP_SECRET=replace-with-at-least-32-random-characters
# Server-only AI credentials; never use NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=replace-with-server-key
GEMINI_VISION_MODEL=replace-with-enabled-vision-model
GEMINI_TTS_MODEL=replace-with-enabled-tts-model
AI_DAILY_CALL_LIMIT=20
# Required to enable real phone registration/reset/OTP, never mocked in production.
SMS_ADAPTER_URL=https://your-sms-adapter.example/send
SMS_ADAPTER_TOKEN=replace-with-sms-token
