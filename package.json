{
  "name": "plantcare-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "build": "next build apps/web",
    "postbuild": "node scripts/check-build-artifacts.mjs",
    "start": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen apps/web && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node scripts/check-production.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:proxy": "node scripts/check-proxy.mjs",
    "test:container": "node scripts/check-container.mjs",
    "test:e2e:mvp": "playwright test --config playwright.mvp.config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@plantcare/postgres-store": "file:packages/postgres-store",
    "bcryptjs": "3.0.3",
    "decimal.js": "10.6.0",
    "fflate": "0.8.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
